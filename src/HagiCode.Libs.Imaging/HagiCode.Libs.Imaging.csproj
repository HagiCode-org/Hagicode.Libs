<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>HagiCode.Libs.Imaging</PackageId>
    <Description>In-process AVIF conversion for HagiCode hosts: PNG, JPEG, WebP, GIF and AVIF sources to AVIF using bundled libvips native libraries. No external executable, no PATH lookup, no child process.</Description>
    <PackageTags>hagicode;imaging;avif;image;libvips;conversion;thumbnail</PackageTags>
    <Authors>HagiCode</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HagiCode-org/Hagicode.Libs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/HagiCode-org/Hagicode.Libs</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\nuget\icon.png" Pack="true" PackagePath="\" Link="icon.png" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Pinned NetVips.Native version. Must match Directory.Packages.props. -->
    <NetVipsNativeVersion>8.18.7</NetVipsNativeVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The package carries its own native assets: one shared libvips library per RID, copied from the NetVips.Native
      package for that RID. Consumers receive only the runtime folder that matches their platform (task 4.2).
    -->
    <None Include="$(NuGetPackageRoot)netvips.native.win-x64/$(NetVipsNativeVersion)/runtimes/win-x64/native/*" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(NuGetPackageRoot)netvips.native.linux-x64/$(NetVipsNativeVersion)/runtimes/linux-x64/native/*" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="$(NuGetPackageRoot)netvips.native.osx-x64/$(NetVipsNativeVersion)/runtimes/osx-x64/native/*" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="$(NuGetPackageRoot)netvips.native.osx-arm64/$(NetVipsNativeVersion)/runtimes/osx-arm64/native/*" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Managed binding. Dependency of the package. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="NetVips" />
    <!-- Per-RID native libvips (one shared library each). PrivateAssets keeps them out of the nuspec dependency list;
         their files are packed under runtimes/<rid>/native instead (task 4.1). -->
    <PackageReference Include="NetVips.Native.win-x64" PrivateAssets="all" />
    <PackageReference Include="NetVips.Native.linux-x64" PrivateAssets="all" />
    <PackageReference Include="NetVips.Native.osx-x64" PrivateAssets="all" />
    <PackageReference Include="NetVips.Native.osx-arm64" PrivateAssets="all" />
  </ItemGroup>
</Project>
