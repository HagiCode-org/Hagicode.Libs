<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\Pi\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Codebuddy\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Omp\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Reasonix\v2.41.0\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\Codex\AppServer\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\OpenCode\v2.0.32\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\ToolCalls\**\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\ClaudeCode\steer\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copied fixtures of a renamed or removed provider directory would otherwise stay in the output and keep the coverage check green. -->
  <Target Name="RemoveStaleToolCallFixtures" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(OutDir)Fixtures/ToolCalls" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HagiCode.Libs.Providers\HagiCode.Libs.Providers.csproj" />
  </ItemGroup>
</Project>
